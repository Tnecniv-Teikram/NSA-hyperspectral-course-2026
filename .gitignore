# ---------------------------------------------------------------------------
# Hyperspectral course — what stays out of the repository
# ---------------------------------------------------------------------------

# Tanager scenes: ~1 GB each. hsi_utils downloads them on demand from Planet's
# public STAC catalogue, so they must never be committed.
*.h5
*.h5.part
data/subsets/

# Everything the notebooks regenerate
outputs/
__pycache__/
.ipynb_checkpoints/
.pytest_cache/

# Slide decks. The .pptx files (31 MB) are never committed: they regenerate
# with  python tools/extract_figures.py  then  python tools/decks/deck_*.py
# The PDF exports in slides/ ARE committed, so participants and co-instructors
# can read the decks without PowerPoint and without a 64 MB download.
*.pptx
~$*
slides/figures/
slides/previews/

# Environments — never keep a virtualenv inside a synced folder
.venv/
venv/
env/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
